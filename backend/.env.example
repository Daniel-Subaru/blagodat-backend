# Скопіюйте в backend/.env і заповніть
PORT=3000

# DigitalOcean Managed PostgreSQL (Connection string з панелі) + SSL
DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/defaultdb?sslmode=require
DB_SSL=true

# Monobank Acquiring (https://web.monobank.ua -> токен мерчанта)
MONOBANK_TOKEN=

# Публічні адреси: сайт і бекенд (HTTPS, для webhook Monobank)
FRONTEND_URL=https://your-domain.com
PUBLIC_API_URL=https://api.your-domain.com

# Telegram-сповіщення про замовлення (бот від @BotFather, chat id від @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключ для доступу до Excel/списку замовлень
ADMIN_KEY=https://1drv.ms/x/c/3a40b3b2195b47d5/IQD6pnvnUfNuRph-HA15Y4hMAfnepqc4auvqLmZ3Gj4HA28?e=MMCq9F
